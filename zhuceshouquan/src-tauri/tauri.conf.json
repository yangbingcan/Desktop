{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "管用GL",
  "version": "0.6.0",
  "identifier": "com.guanyong-gl.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "管用GL - 企业资源管理",
        "width": 1600,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "maximized": true,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https://asset.localhost http://asset.localhost; connect-src 'self' ws://localhost:* http://localhost:*; font-src 'self' data:; frame-src 'none'; object-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$APPDATA/**", "$APPDATA/assets/**"],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
